# Copia este archivo a .env.local para desarrollo local (NUNCA lo subas a git).
# En producción, estas mismas variables se configuran en Vercel:
# Project Settings → Environment Variables.

# Notion → Settings → Connections → New integration → copia el "Internal Integration Secret".
# Luego comparte la base "Solicitudes de Factura" con esa integración (··· → Connections → agrégala).
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# El ID de la base "Solicitudes de Factura" (de su URL en Notion, sin guiones es igual de válido):
NOTION_DATABASE_ID=53ee6e27d63a4e22a8fc3cab4eef889e

# Panel de administración (/admin) — perfiles de cliente con link propio.

# Base de datos Postgres para guardar los perfiles. Ya existe una (Supabase
# Free, "supabase-teal-zebra") conectada al equipo de Vercel. Una vez que el
# proyecto esté desplegado, conéctala desde Storage → Connect to Project, y
# corre `vercel link && vercel env pull .env.local` para traerte POSTGRES_URL
# sin copiarla a mano (ver README). DATABASE_URL es el respaldo manual si
# alguna vez usas otra base Postgres en vez de la de Vercel.
DATABASE_URL=postgres://usuario:contraseña@host/basededatos

# La contraseña para entrar a /admin. Ponla tú, algo que solo tú sepas —
# no hay usuario, es una sola contraseña compartida para el panel.
ADMIN_PASSWORD=cambia-esto-por-una-contraseña-tuya

# Clave para firmar la sesión del panel — una cadena larga y aleatoria,
# distinta a ADMIN_PASSWORD. Genera una con: openssl rand -base64 32
SESSION_SECRET=genera-una-cadena-aleatoria-larga-aqui
